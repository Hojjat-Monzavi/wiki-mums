---
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import {
  getArticlesByCategory,
  humanize,
  CATEGORY_DESCRIPTIONS,
} from '../../lib/articles';
import { withBase } from '../../lib/base';

const groups = await getArticlesByCategory();
const sortedSlugs = [...groups.keys()].sort();

const totalArticles = [...groups.values()].reduce((n, g) => n + g.length, 0);
---

<Base title="Categories" description="All categories on WikiMUMS.">
  <div class="page">
    <Sidebar />

    <main class="main" id="main">
      <h1 class="page-title">All categories</h1>
      <p class="lead">
        WikiMUMS شامل {totalArticles} مقاله در {sortedSlugs.length} تخصص پزشکی است.
        یکی از دسته‌بندی‌های زیر را برای مشاهده فهرست کامل مقالات انتخاب کنید.
        مقالات هر دسته‌بندی به ترتیب الفبا در صفحه مربوط به آن قرار دارند.
      </p>

      <div class="category-grid category-grid--large">
        {sortedSlugs.map((slug) => {
          const items = groups.get(slug)!;
          const preview = items.slice(0, 4);
          const extra = items.length - preview.length;
          return (
            <article class="category-card--large">
              <div class="category-card--large__header">
                <h2 class="category-card--large__title">
                  <a href={withBase(`/categories/${slug}`)}>{humanize(slug)}</a>
                </h2>
                <span class="category-card--large__count">{items.length} جستار</span>
              </div>
              <p class="category-card--large__desc">
                {CATEGORY_DESCRIPTIONS[slug] ?? 'جستارهای این دسته'}
              </p>
              <ul class="category-card--large__preview">
                {preview.map((entry) => (
                  <li><a href={withBase(`/articles/${entry.slug}`)}>{entry.data.title}</a></li>
                ))}
              </ul>
              {extra > 0 && (
                <a class="category-card--large__more" href={withBase(`/categories/${slug}`)}>
                  + {extra} more article{extra === 1 ? '' : 's'} →
                </a>
              )}
            </article>
          );
        })}
      </div>
    </main>
  </div>
</Base>

<style>
  .category-grid--large {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0 2rem;
  }
  @media (max-width: 480px) {
    .category-grid--large { grid-template-columns: 1fr; }
  }
</style>
