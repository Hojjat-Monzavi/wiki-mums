---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="Page not found.">
  <div class="page">
    <main class="main not-found" id="main">
      <h1>404</h1>
      <p>This article does not exist. You can <a href="/search">search</a> for it,
        <a href="/categories">browse categories</a>, or go <a href="/">home</a>.</p>
      <p style="margin-top: 2rem;">
        <a href="/random">→ Read a random article</a>
      </p>
    </main>
  </div>
</Base>
