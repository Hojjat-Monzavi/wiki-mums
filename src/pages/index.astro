---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {
  getAllArticles,
  getArticlesByCategory,
  humanize,
  CATEGORY_DESCRIPTIONS,
} from '../lib/articles';
import { withBase } from '../lib/base';

const all = await getAllArticles();
const groups = await getArticlesByCategory();

const totalArticles = all.length;
const totalCategories = groups.size;

// "Featured" — pick the article with a cover image if any, else the first.
const featured = all.find((a) => a.data.cover) ?? all[0];

// "Recently added" — last 5 articles by sort order
const recent = [...all].reverse().slice(0, 5);
---

<Base title="WikiMUMS" description="A free, open-access medical encyclopedia.">
  <div class="page">
    <Sidebar />

    <main class="main" id="main">
      <h1 class="page-title">به ویکی مامز خوش آمدید!</h1>
      <p class="lead">
        یک دانشنامه پزشکی آزاد با دسترسی رایگان. در میان {totalArticles} مقاله در {totalCategories} دسته بندی مختلف مطالعه کنید — 
        نوشته‌شده به زبانی ساده و با لینک‌های داخلی متصل‌به‌هم، تا بتوانید به سادگی
        موضوعات را یکی پس از دیگری بررسی و مطالعه کنید.
      </p>

      <h2>دسته بندی ها</h2>
      <div class="category-grid">
        {[...groups.keys()].sort().map((slug) => (
          <a class="category-card" href={withBase(`/categories/${slug}`)}>
            <h3>{humanize(slug)}</h3>
            <p>{CATEGORY_DESCRIPTIONS[slug] ?? 'جستار های این دسته'}</p>
            <small>{groups.get(slug)!.length} جستار</small>
          </a>
        ))}
      </div>

      <h2>جستار های تازه اضافه شده</h2>
      <ul class="article-list">
        {recent.map((entry) => <ArticleCard entry={entry} />)}
      </ul>

      <h2>جستار های گلچین</h2>
      {featured && (
        <ul class="article-list">
          <ArticleCard entry={featured} />
        </ul>
      )}
    </main>
  </div>
</Base>
