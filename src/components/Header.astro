---
import { withBase } from '../lib/base';

const nav = [
  { label: 'Home', href: withBase('/') },
  { label: 'Categories', href: withBase('/categories') },
  { label: 'Random', href: withBase('/random') },
  { label: 'About', href: withBase('/about') },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={withBase('/')} class="brand" aria-label="MedWiki home">
      <img src={withBase('/favicon.svg')} alt="" class="brand__logo" width="28" height="28" />
      <span class="brand__name">
        MedWiki
        <small>The free medical encyclopedia</small>
      </span>
    </a>

    <div class="search-wrap">
      <form class="search-form" action={withBase('/search')} method="get" role="search" autocomplete="off">
        <input
          type="search"
          name="q"
          id="header-search"
          placeholder="Search articles, synonyms…"
          aria-label="Search MedWiki"
          autocomplete="off"
          aria-expanded="false"
          aria-controls="search-dropdown"
        />
        <button type="submit">Search</button>
      </form>
      <div
        id="search-dropdown"
        class="search-dropdown"
        role="listbox"
        aria-label="Search suggestions"
        hidden
      ></div>
    </div>

    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">☰</button>

    <nav class="header-nav" id="header-nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
  </div>
</header>

<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL || '/' }}>
  // --------------------------------------------------------------------
  // Header search — fully client-side.
  // The index is fetched once from <baseUrl>search-index.json on first
  // focus, then filtered locally for every keystroke. A small dropdown
  // shows the top 6 matches with thumbnails; Enter jumps to
  // <baseUrl>search?q=... for the full results page.
  // --------------------------------------------------------------------
  (function () {
    // Normalize: always end with exactly one slash. Astro may give us
    // '/wiki-mums' (no trailing slash) or '/' — handle both.
    var normalizedBase = (baseUrl || '/').replace(/\/+$/, '') + '/';

    function withBase(p) {
      if (!p) return normalizedBase.replace(/\/$/, '') || '/';
      if (p.startsWith('#') || p.startsWith('?')) return p;
      if (/^[a-z]+:/i.test(p)) return p;
      if (baseUrl !== '/' && p.startsWith(normalizedBase)) return p;
      if (p === '/') return normalizedBase.replace(/\/$/, '') || '/';
      var stripped = p.replace(/^\/+/, '');
      return normalizedBase + stripped;
    }
    const input = document.getElementById('header-search');
    const dropdown = document.getElementById('search-dropdown');
    if (!input || !dropdown) return;

    let index = null;
    let loadingPromise = null;

    function loadIndex() {
      if (index) return Promise.resolve(index);
      if (loadingPromise) return loadingPromise;
      loadingPromise = fetch(withBase('/search-index.json'))
        .then((r) => r.json())
        .then((data) => {
          index = data;
          return data;
        })
        .catch(() => {
          index = [];
          return index;
        });
      return loadingPromise;
    }

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])
      );
    }

    function highlight(text, q) {
      if (!q) return escapeHtml(text);
      const safe = escapeHtml(text);
      const re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
      return safe.replace(re, '<mark>$1</mark>');
    }

    function score(item, q) {
      const t = item.title.toLowerCase();
      // Title-prefix beats title-contains beats synonym match.
      if (t.startsWith(q)) return 100 - t.length;
      if (t.includes(q)) return 60 - t.indexOf(q);
      if ((item.synonyms || []).some((s) => s.toLowerCase().includes(q))) return 30;
      return 10;
    }

    function render(q, idx) {
      const trimmed = q.trim().toLowerCase();
      if (!trimmed) {
        dropdown.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        dropdown.innerHTML = '';
        return;
      }

      const matches = idx
        .map((item) => ({ item, s: score(item, trimmed) }))
        .filter((x) => x.s > 0 || (
          // Fall back to substring on title+synonyms so description-free matches still surface.
          (x.item.title + ' ' + (x.item.synonyms || []).join(' '))
            .toLowerCase()
            .includes(trimmed)
        ))
        .sort((a, b) => b.s - a.s)
        .slice(0, 6);

      if (matches.length === 0) {
        dropdown.innerHTML =
          '<div class="search-dropdown__empty">No matches for “' +
          escapeHtml(q) +
          '”</div>' +
          '<a class="search-dropdown__all" href="' + withBase('/search') + '?q=' +
          encodeURIComponent(q) +
          '">Full search →</a>';
        dropdown.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        return;
      }

      dropdown.innerHTML =
        matches
          .map(
            ({ item }) =>
              '<a class="search-dropdown__item" href="' +
              item.href +
              '" role="option">' +
              '<img class="search-dropdown__thumb" src="' +
              item.cover +
              '" alt="" />' +
              '<div class="search-dropdown__text">' +
              '<div class="search-dropdown__title">' +
              highlight(item.title, trimmed) +
              '</div>' +
              '<div class="search-dropdown__desc">' +
              escapeHtml(item.description) +
              '</div>' +
              '<div class="search-dropdown__cat">' +
              escapeHtml(item.category) +
              '</div>' +
              '</div></a>'
          )
          .join('') +
        '<a class="search-dropdown__all" href="' + withBase('/search') + '?q=' +
        encodeURIComponent(q) +
        '">All results for “' +
        escapeHtml(q) +
        '” →</a>';

      dropdown.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    let debounceId;
    input.addEventListener('input', () => {
      const v = input.value;
      window.clearTimeout(debounceId);
      debounceId = window.setTimeout(() => {
        loadIndex().then((idx) => idx && render(v, idx));
      }, 80);
    });

    input.addEventListener('focus', () => {
      loadIndex().then((idx) => idx && render(input.value, idx));
    });

    document.addEventListener('click', (e) => {
      // Close dropdown when clicking outside the search wrap.
      const wrap = input.closest('.search-wrap');
      if (wrap && !wrap.contains(e.target)) {
        dropdown.hidden = true;
        input.setAttribute('aria-expanded', 'false');
      }
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdown.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        input.blur();
      }
    });

    // Allow form submit to go to /search?q=... (the form already has action+method).
    // No JS override needed — Enter on the input submits the form by default.

    // Mobile nav toggle
    const toggle = document.querySelector('.nav-toggle');
    const nav = document.getElementById('header-nav');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(!!open));
    });
  })();
</script>
