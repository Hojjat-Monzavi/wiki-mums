---
import { withBase } from '../lib/base';

const year = new Date().getFullYear();

const links = [
  { label: 'درباره ما', href: withBase('/about') },
  { label: 'مشاهده مقالات', href: withBase('/categories') },
  { label: 'جست و جو', href: withBase('/search') },
];

const cats = [
  { label: 'Cardiology', slug: 'cardiology' },
  { label: 'Neurology', slug: 'neurology' },
  { label: 'Respiratory', slug: 'respiratory' },
  { label: 'Endocrinology', slug: 'endocrinology' },
  { label: 'Gastroenterology', slug: 'gastroenterology' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <h4>WikiMUMS</h4>
        <p>یک دانشنامه پزشکی رایگان و با دسترسی آزاد که برای استفاده‌ی آموزشی نوشته و پشتیبانی می‌شود.</p>
        <p>مشاوران علمی طرح : دکتر الناز وفادار و دکتر مصطفی جعفری</p>
        <p>با تشکر از تیم دانشجویی TTEA</p>
      <p style="margin-top:0.5rem;">
        {links.map((l, i) => (
          <Fragment>
            {i > 0 && ' · '}
            <a href={l.href}>{l.label}</a>
          </Fragment>
        ))}
      </p>
    </div>
    <div>
      <h4>دسته بندی ها</h4>
      <ul>
        {cats.map((c) => (
          <li><a href={withBase(`/categories/${c.slug}`)}>{c.label}</a></li>
        ))}
      </ul>
    </div>

  </div>
  <div class="site-footer__bottom">
    WikiMUMS
  </div>
</footer>
