---
import { withBase } from '../lib/base';

const year = new Date().getFullYear();

const links = [
  { label: 'About', href: withBase('/about') },
  { label: 'Browse', href: withBase('/categories') },
  { label: 'Search', href: withBase('/search') },
];

const cats = [
  { label: 'Cardiology', slug: 'cardiology' },
  { label: 'Neurology', slug: 'neurology' },
  { label: 'Respiratory', slug: 'respiratory' },
  { label: 'Endocrinology', slug: 'endocrinology' },
  { label: 'Gastroenterology', slug: 'gastroenterology' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <h4>MedWiki</h4>
      <p>
        A free, open-access medical encyclopedia written and maintained for educational use.
        Articles are organized by specialty and interlinked so you can browse naturally from
        one topic to the next.
      </p>
      <p style="margin-top:0.5rem;">
        {links.map((l, i) => (
          <Fragment>
            {i > 0 && ' · '}
            <a href={l.href}>{l.label}</a>
          </Fragment>
        ))}
      </p>
    </div>
    <div>
      <h4>Categories</h4>
      <ul>
        {cats.map((c) => (
          <li><a href={withBase(`/categories/${c.slug}`)}>{c.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Disclaimer</h4>
      <p>MedWiki does not provide medical advice. Always consult a qualified healthcare professional.</p>
    </div>
  </div>
  <div class="site-footer__bottom">
    © {year} MedWiki · Content available for educational use · Built with Astro
  </div>
</footer>
