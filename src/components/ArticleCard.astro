---
import type { CollectionEntry } from 'astro:content';
import { coverFor } from '../lib/articles';
import { withBase } from '../lib/base';

interface Props {
  entry: CollectionEntry<'articles'>;
  excerpt?: string;
  showThumb?: boolean;
}

const { entry, excerpt, showThumb = true } = Astro.props;
const { title, description, category, lastUpdated } = entry.data;

const dateStr = lastUpdated
  ? lastUpdated.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
const thumb = coverFor(entry);
const articleHref = withBase(`/articles/${entry.slug}`);
---

<li class={showThumb ? 'article-list__item article-list__item--thumb' : 'article-list__item'}>
  {showThumb && (
    <a class="article-list__thumb" href={articleHref} aria-hidden="true" tabindex="-1">
      <img src={thumb} alt="" loading="lazy" />
    </a>
  )}
  <div class="article-list__body">
    <h3><a href={articleHref}>{title}</a></h3>
    <p>{excerpt || description}</p>
    <p class="meta">📂 {category}{dateStr ? ` · updated ${dateStr}` : ''}</p>
  </div>
</li>
